datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  EXECUTIVE
}

enum ApplicationStatus {
  NEW
  WAITING_FOR_INFORMATION
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum SyncStatus {
  NOT_REQUIRED
  PENDING
  SYNCED
  FAILED
}

model Team {
  id        String   @id @default(cuid())
  name      String
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id                   String        @id @default(cuid())
  name                 String
  email                String        @unique
  role                 Role
  teamId               String?
  team                 Team?         @relation(fields: [teamId], references: [id])
  assignedApplications Application[] @relation("AssignedApplications")
  createdApplications  Application[] @relation("CreatedApplications")
  assignedWorkItems    WorkItem[]    @relation("AssignedWorkItems")
  createdWorkItems     WorkItem[]    @relation("CreatedWorkItems")
  activities           Activity[]
  createdAt            DateTime      @default(now())
}

model Customer {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Application {
  id              String            @id @default(cuid())
  referenceNumber String            @unique
  title           String
  description     String
  status          ApplicationStatus @default(NEW)
  priority        Priority          @default(MEDIUM)
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])
  assignedToId    String?
  assignedTo      User?             @relation("AssignedApplications", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User              @relation("CreatedApplications", fields: [createdById], references: [id])
  workItems       WorkItem[]
  activities      Activity[]
  syncStatus      SyncStatus        @default(NOT_REQUIRED)
  syncAttempts    Int               @default(0)
  lastSyncError   String?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model WorkItem {
  id            String         @id @default(cuid())
  title         String
  description   String?
  status        WorkItemStatus @default(TODO)
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id])
  assignedToId  String?
  assignedTo    User?          @relation("AssignedWorkItems", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User           @relation("CreatedWorkItems", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  completedAt   DateTime?
}

model Activity {
  id            String      @id @default(cuid())
  type          String
  description   String
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  performedById String
  performedBy   User        @relation(fields: [performedById], references: [id])
  createdAt     DateTime    @default(now())
}
